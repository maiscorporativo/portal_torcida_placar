# E-Mais CMS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# ── Banco de Dados MySQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=emais_cms

# ── Admin ───────────────────────────────────────────────────────
# Token usado pelo painel /admin para autenticar saves na API
ADMIN_TOKEN=emais2025

# ── Servidor ────────────────────────────────────────────────────
# Hostinger define PORT automaticamente, não altere em produção
PORT=3001
NODE_ENV=development

# ── Uploads persistentes ────────────────────────────────────────
# Caminho ABSOLUTO onde as imagens enviadas pelo admin são gravadas.
# Em produção, aponte para uma pasta FORA da área de deploy para que
# novas implantações NUNCA apaguem as imagens.
# Ex (Hostinger): UPLOADS_DIR=/home/u770723521/domains/torcidaplacar.tur.br/uploads_persistentes
# Se vazio, usa public/uploads (padrão para desenvolvimento local).
# UPLOADS_DIR=

# ── Banco COMPARTILHADO de pacotes (integração dos 3 portais) ────
# Mesmos valores nos 3 sites (torcida, emais, gp). Sem SHARED_DB_NAME,
# a integração fica desativada e o portal usa apenas o banco próprio.
# Host/porta: iguais aos do banco próprio (ex: 127.0.0.1 e a mesma DB_PORT).
# SHARED_DB_HOST=127.0.0.1
# SHARED_DB_PORT=3306
# SHARED_DB_NAME=
# SHARED_DB_USER=
# SHARED_DB_PASSWORD=
