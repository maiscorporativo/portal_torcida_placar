# E-Mais CMS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais

# ── Banco de Dados MySQL ────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=emais_cms

# ── Admin ───────────────────────────────────────────────────────
# Token usado pelo painel /admin para autenticar saves na API
ADMIN_TOKEN=emais2025

# ── Servidor ────────────────────────────────────────────────────
# Hostinger define PORT automaticamente, não altere em produção
PORT=3001
NODE_ENV=development

# ── Uploads persistentes ────────────────────────────────────────
# Caminho ABSOLUTO onde as imagens enviadas pelo admin são gravadas.
# Em produção, aponte para uma pasta FORA da área de deploy para que
# novas implantações NUNCA apaguem as imagens.
# Ex (Hostinger): UPLOADS_DIR=/home/u770723521/domains/torcidaplacar.tur.br/uploads_persistentes
# Se vazio, usa public/uploads (padrão para desenvolvimento local).
# UPLOADS_DIR=
